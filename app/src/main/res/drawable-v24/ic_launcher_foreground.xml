<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Footstep Path Loop (Concept C) -->
    <!-- Represents the infinite journey of the flâneur -->

    <!-- Base Path Line (Subtle guide in Midnight Blue, very light alpha) -->
    <path
        android:strokeColor="#2C3E50"
        android:strokeWidth="1"
        android:strokeAlpha="0.1"
        android:strokeLineCap="round"
        android:pathData="M30,54 C30,30 78,30 78,54 C78,78 30,78 30,54 Z" />

    <!-- Footprints (Encounter Gold) -->
    <!-- Each pair represents a step along the infinite loop -->

    <!-- Step 1: Bottom Center-ish -->
    <path
        android:fillColor="#D4AF37"
        android:pathData="M52,76 A2.5,4 0 0,1 47,76 A2.5,4 0 0,1 52,76 Z M58,82 A2.5,4 0 0,1 53,82 A2.5,4 0 0,1 58,82 Z" />

    <!-- Step 2: Right side heading up -->
    <path
        android:fillColor="#D4AF37"
        android:pathData="M76,60 A4,2.5 90 0,1 76,55 A4,2.5 90 0,1 76,60 Z M82,54 A4,2.5 90 0,1 82,49 A4,2.5 90 0,1 82,54 Z" />

    <!-- Step 3: Top Center-ish -->
    <path
        android:fillColor="#D4AF37"
        android:pathData="M56,32 A2.5,4 0 0,1 51,32 A2.5,4 0 0,1 56,32 Z M50,26 A2.5,4 0 0,1 45,26 A2.5,4 0 0,1 50,26 Z" />

    <!-- Step 4: Left side heading down -->
    <path
        android:fillColor="#D4AF37"
        android:pathData="M32,48 A4,2.5 90 0,1 32,53 A4,2.5 90 0,1 32,48 Z M26,54 A4,2.5 90 0,1 26,59 A4,2.5 90 0,1 26,54 Z" />

    <!-- The 'Discovery' Spark (Tension Crimson) -->
    <!-- A small indicator that a destination is found during the walk -->
    <path
        android:fillColor="#E74C3C"
        android:pathData="M78,54 A3,3 0 1,1 72,54 A3,3 0 1,1 78,54 Z" />

</vector>
